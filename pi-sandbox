#!/usr/bin/env zsh
set -eu

NAME="pi-sandbox-${PWD:t}-$$"
NAME="${NAME//[^a-zA-Z0-9_.-]/-}"

exec docker run --rm -it \
  -e ANTHROPIC_API_KEY \
  -e TERM \
  -e COLORTERM \
  -w "$PWD" \
  --name "$NAME" \
  --mount type=bind,source="$PWD",target="$PWD" \
  --mount type=bind,source="$HOME/.pi/agent",target=/root/.pi/agent \
  pi-sandbox "$@"
