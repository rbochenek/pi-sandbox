#!/usr/bin/env zsh
set -eu

NAME="pi-sandbox-${PWD:t}-$$"
NAME="${NAME//[^a-zA-Z0-9_.-]/-}"

AGENT_DIR="$HOME/.pi/agent"

# Agent state lives in a named volume so platform-specific stuff pi manages
# (auto-installed binaries in bin/, model caches, npm packages) stays
# container-native. Bind-mounting the host agent dir leaks macOS binaries
# (e.g. bin/fd) into the Linux container, which silently breaks @ file
# completion: pi sees the file exists, skips its Linux download, then fails
# to exec it.
# Suffix the volume with the uid so different host users get isolated,
# correctly-owned state instead of fighting over one volume's ownership.
docker_args=(
  --mount "type=volume,source=pi-sandbox-agent-$(id -u),target=/home/agent/.pi/agent"
)

# Host-managed config files shared into the container. pi writes these in
# place (no atomic renames), so single-file bind mounts are safe, and edits
# made inside the container persist on the host.
for f in settings.json models.json auth.json trust.json; do
  if [[ -f "$AGENT_DIR/$f" ]]; then
    docker_args+=(--mount "type=bind,source=$AGENT_DIR/$f,target=/home/agent/.pi/agent/$f")
  fi
done

# Sessions and optional agent-dir resources are shared too. Session/trust
# paths line up because the project is bind-mounted at its real host path.
for d in sessions extensions skills prompts themes; do
  if [[ -d "$AGENT_DIR/$d" ]]; then
    docker_args+=(--mount "type=bind,source=$AGENT_DIR/$d,target=/home/agent/.pi/agent/$d")
  fi
done

# Docker-out-of-docker: bind the host docker socket in so the agent can run
# 'docker', 'docker compose', etc. against the host daemon. This gives the
# agent root-equivalent control of the host (the sandbox boundary becomes
# just the daemon's), so set PI_SANDBOX_NO_DOCKER=1 to keep the sandbox
# hermetic.
if [[ -z "${PI_SANDBOX_NO_DOCKER:-}" && -S /var/run/docker.sock ]]; then
  docker_args+=(--mount "type=bind,source=/var/run/docker.sock,target=/var/run/docker.sock")
  # Grant the socket's group as a supplementary group so the non-root agent
  # uid can open it. Linux hosts: root:docker (or root:root when the host
  # has no docker group). macOS: Docker Desktop serves the Mac socket into
  # its Linux VM as a root-owned proxy socket (/host-services/...), so the
  # container always sees root:root — the group is 0 there, and BSD stat
  # can't be used anyway.
  if [[ "$(uname -s)" == Darwin ]]; then
    docker_args+=(--group-add 0)
  else
    docker_args+=(--group-add "$(stat -c %g /var/run/docker.sock)")
  fi
fi

# Run as the host user (uid/gid 1000 baked into the image as 'agent') so
# files pi creates on bind mounts — sessions included — are owned by the
# host user, not root. HOME points at the agent user's home for pi's
# container-local state (named volume below).
exec docker run --rm -it \
  --user "$(id -u):$(id -g)" \
  -e HOME=/home/agent \
  -e ANTHROPIC_API_KEY \
  -e TERM \
  -e COLORTERM \
  -w "$PWD" \
  --name "$NAME" \
  "${docker_args[@]}" \
  --mount "type=bind,source=$PWD,target=$PWD" \
  pi-sandbox "$@"
